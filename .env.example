# Cadena de conexion de Neon (o cualquier Postgres). Incluye ?sslmode=require para Neon.
DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Puerto donde corre la API
PORT=3000

# Secreto para firmar los JWT (cambialo por uno propio y largo en produccion)
JWT_SECRET=cambia_este_valor_por_uno_seguro
JWT_EXPIRES_IN=8h
